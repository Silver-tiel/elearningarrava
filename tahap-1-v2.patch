diff -ruN a/tests/Feature/PendaftaranTest.php b/tests/Feature/PendaftaranTest.php
--- a/tests/Feature/PendaftaranTest.php	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/Feature/PendaftaranTest.php	2026-10-28 06:42:03.009677950 +0000
@@ -0,0 +1,138 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\User;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Schema;
+use Tests\TestCase;
+
+/**
+ * M1: pendaftaran siswa harus benar-benar bisa dipakai.
+ * Regresi utama: form mengirim "nomor_hp", sehingga controller wajib memvalidasi "nomor_hp"
+ * (dulu "nomor_handphone", akibatnya semua pendaftaran gagal).
+ */
+class PendaftaranTest extends TestCase
+{
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        Schema::create('jenjang', function (Blueprint $table) {
+            $table->increments('id_jenjang');
+            $table->string('nama_tipe');
+        });
+
+        Schema::create('user', function (Blueprint $table) {
+            $table->increments('id_user');
+            $table->string('nama');
+            $table->string('email')->unique();
+            $table->string('password');
+            $table->string('nisn')->unique()->nullable();
+            $table->string('nomor_hp')->nullable();
+            $table->unsignedInteger('id_jenjang')->nullable();
+            $table->unsignedInteger('id_tipeuser')->default(1);
+            $table->integer('total_poin')->default(0);
+            $table->string('status_akun')->default('Aktif');
+            $table->timestamps();
+        });
+
+        DB::table('jenjang')->insert(['nama_tipe' => 'SMA']);
+    }
+
+    /** Data persis seperti yang dikirim form pendaftaran. */
+    private function dataValid(array $ganti = []): array
+    {
+        return array_merge([
+            'nama' => 'Siti Nur-Aini',
+            'email' => 'siti@example.com',
+            'nisn' => '0012345678',
+            'nomor_hp' => '081234567890',
+            'password' => 'rahasia123',
+            'password_confirmation' => 'rahasia123',
+            'id_jenjang' => 1,
+        ], $ganti);
+    }
+
+    public function test_form_mengirim_field_yang_sama_dengan_yang_divalidasi(): void
+    {
+        $this->get('/pendaftaran')
+            ->assertOk()
+            ->assertSee('name="nomor_hp"', false)
+            ->assertDontSee('nomor_handphone', false);
+    }
+
+    public function test_siswa_bisa_mendaftar_dengan_data_yang_valid(): void
+    {
+        $this->from('/pendaftaran')
+            ->post('/pendaftaran', $this->dataValid())
+            ->assertRedirect('/login')
+            ->assertSessionHas('success');
+
+        $this->assertDatabaseHas('user', [
+            'email' => 'siti@example.com',
+            'nisn' => '0012345678',
+            'nomor_hp' => '081234567890',
+            'id_tipeuser' => 3,
+        ]);
+
+        $user = User::where('email', 'siti@example.com')->first();
+        $this->assertTrue(Hash::check('rahasia123', $user->password));
+    }
+
+    public function test_nama_dengan_apostrof_titik_strip_dan_huruf_bertanda_diterima(): void
+    {
+        $daftarNama = ["Ma'ruf", 'Siti Nur-Aini', 'Dr. Budi', 'José Álvarez'];
+
+        foreach ($daftarNama as $i => $nama) {
+            $this->from('/pendaftaran')
+                ->post('/pendaftaran', $this->dataValid([
+                    'nama' => $nama,
+                    'email' => "siswa{$i}@example.com",
+                    'nisn' => '00123456' . str_pad((string) $i, 2, '0', STR_PAD_LEFT),
+                ]))
+                ->assertSessionHasNoErrors()
+                ->assertRedirect('/login');
+        }
+
+        $this->assertSame(count($daftarNama), User::count());
+    }
+
+    public function test_nama_berisi_angka_atau_simbol_berbahaya_ditolak(): void
+    {
+        foreach (['Budi123', 'Budi <script>', 'Budi@home'] as $nama) {
+            $this->from('/pendaftaran')
+                ->post('/pendaftaran', $this->dataValid(['nama' => $nama]))
+                ->assertSessionHasErrors('nama');
+        }
+
+        $this->assertSame(0, User::count());
+    }
+
+    public function test_nomor_hp_kosong_menampilkan_pesan_yang_jelas(): void
+    {
+        $this->from('/pendaftaran')
+            ->post('/pendaftaran', $this->dataValid(['nomor_hp' => '']))
+            ->assertSessionHasErrors(['nomor_hp' => 'Nomor handphone wajib diisi.']);
+    }
+
+    public function test_nisn_harus_10_digit_angka(): void
+    {
+        $this->from('/pendaftaran')
+            ->post('/pendaftaran', $this->dataValid(['nisn' => '12345']))
+            ->assertSessionHasErrors(['nisn' => 'NISN harus terdiri dari 10 digit.']);
+
+        $this->from('/pendaftaran')
+            ->post('/pendaftaran', $this->dataValid(['nisn' => '12345abcde']))
+            ->assertSessionHasErrors(['nisn' => 'NISN hanya boleh berisi angka.']);
+    }
+
+    public function test_konfirmasi_kata_sandi_harus_cocok(): void
+    {
+        $this->from('/pendaftaran')
+            ->post('/pendaftaran', $this->dataValid(['password_confirmation' => 'beda12345']))
+            ->assertSessionHasErrors(['password' => 'Konfirmasi kata sandi tidak cocok.']);
+    }
+}

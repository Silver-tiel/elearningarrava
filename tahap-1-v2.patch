diff -ruN a/tests/Feature/AdminAreaAccessTest.php b/tests/Feature/AdminAreaAccessTest.php
--- a/tests/Feature/AdminAreaAccessTest.php	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/Feature/AdminAreaAccessTest.php	2026-10-28 06:42:02.996778420 +0000
@@ -0,0 +1,106 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\User;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+use Tests\TestCase;
+
+/**
+ * M4: dasbor /admin hanya untuk admin dan guru.
+ * Regresi: dulu hanya siswa yang diblokir, sehingga orang tua bisa melihat
+ * nama dan email siswa lain di dasbor admin.
+ */
+class AdminAreaAccessTest extends TestCase
+{
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        Schema::create('user', function (Blueprint $table) {
+            $table->increments('id_user');
+            $table->string('nama');
+            $table->string('email')->unique();
+            $table->string('password');
+            $table->unsignedInteger('id_tipeuser')->default(1);
+            $table->integer('total_poin')->default(0);
+            $table->string('status_akun')->default('Aktif');
+            $table->timestamps();
+        });
+
+        Schema::create('modul', function (Blueprint $table) {
+            $table->increments('id_modul');
+            $table->string('judul_modul');
+            $table->string('file_materi')->nullable();
+            $table->string('tipe_file')->nullable();
+            $table->unsignedInteger('id_tipemodul')->nullable();
+            $table->unsignedInteger('id_jenjang')->nullable();
+            $table->unsignedInteger('id_quiz')->nullable();
+            $table->string('progressModul')->nullable();
+            $table->string('foto_modul')->nullable();
+            $table->timestamps();
+        });
+
+        Schema::create('quiz', function (Blueprint $table) {
+            $table->increments('id_quiz');
+            $table->string('judul')->nullable();
+        });
+
+        Schema::create('achievements', function (Blueprint $table) {
+            $table->increments('id_achievement');
+            $table->string('nama_achivement', 255);
+            $table->unsignedInteger('minimal_poin_achivement')->default(0);
+            $table->string('gambar_achivement', 255)->nullable();
+            $table->text('deskripsi')->nullable();
+            $table->boolean('is_active')->default(true);
+            $table->timestamps();
+        });
+    }
+
+    private function buatUser(int $tipe, string $email): User
+    {
+        return User::create([
+            'nama' => "Pengguna tipe {$tipe}",
+            'email' => $email,
+            'password' => bcrypt('password'),
+            'id_tipeuser' => $tipe,
+        ]);
+    }
+
+    public function test_tamu_diarahkan_ke_halaman_login(): void
+    {
+        $this->get('/admin')->assertRedirect('/login');
+    }
+
+    public function test_siswa_tidak_boleh_membuka_dasbor_admin(): void
+    {
+        $this->actingAs($this->buatUser(3, 'siswa@example.com'))
+            ->get('/admin')
+            ->assertForbidden();
+    }
+
+    public function test_orang_tua_tidak_boleh_membuka_dasbor_admin_dan_tidak_melihat_data_siswa(): void
+    {
+        $this->buatUser(3, 'rahasia.anak.lain@example.com');
+
+        $this->actingAs($this->buatUser(4, 'orangtua@example.com'))
+            ->get('/admin')
+            ->assertForbidden()
+            ->assertDontSee('rahasia.anak.lain@example.com');
+    }
+
+    public function test_admin_boleh_membuka_dasbor_admin(): void
+    {
+        $this->actingAs($this->buatUser(1, 'admin@example.com'))
+            ->get('/admin')

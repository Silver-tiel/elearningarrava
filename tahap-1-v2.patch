diff -ruN a/tests/Feature/ModulApiAuthorizationTest.php b/tests/Feature/ModulApiAuthorizationTest.php
--- a/tests/Feature/ModulApiAuthorizationTest.php	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/Feature/ModulApiAuthorizationTest.php	2026-10-28 06:42:03.000078125 +0000
@@ -0,0 +1,259 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Modul;
+use App\Models\Quiz;
+use App\Models\User;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+use Laravel\Sanctum\Sanctum;
+use Tests\TestCase;
+
+/**
+ * M2: API modul.
+ *  - Hanya admin/guru yang boleh menambah, mengubah, dan menghapus modul.
+ *  - Semua pengguna login boleh MEMBACA modul, tetapi siswa tidak boleh melihat modul draf
+ *    dan token kuis tidak boleh ikut terkirim.
+ */
+class ModulApiAuthorizationTest extends TestCase
+{
+    private int $urut = 0;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        Schema::create('user', function (Blueprint $table) {
+            $table->increments('id_user');
+            $table->string('nama');
+            $table->string('email')->unique();
+            $table->string('password');
+            $table->unsignedInteger('id_tipeuser')->default(1);
+            $table->integer('total_poin')->default(0);
+            $table->string('status_akun')->default('Aktif');
+            $table->timestamps();
+        });
+
+        Schema::create('jenjang', function (Blueprint $table) {
+            $table->increments('id_jenjang');
+            $table->string('nama_tipe');
+        });
+
+        Schema::create('tipemodul', function (Blueprint $table) {
+            $table->increments('id_tipemodul');
+            $table->string('nama_tipe');
+        });
+
+        Schema::create('quiz', function (Blueprint $table) {
+            $table->increments('id_quiz');
+            $table->string('judul')->nullable();
+            $table->unsignedInteger('id_jenjang')->nullable();
+            $table->string('token')->nullable();
+        });
+
+        Schema::create('modul', function (Blueprint $table) {
+            $table->increments('id_modul');
+            $table->string('judul_modul');
+            $table->string('file_materi')->nullable();
+            $table->string('tipe_file')->nullable();
+            $table->unsignedInteger('id_tipemodul');
+            $table->unsignedInteger('id_jenjang');
+            $table->unsignedInteger('id_quiz')->nullable();
+            $table->string('progressModul')->nullable();
+            $table->string('foto_modul')->nullable();
+            $table->timestamps();
+        });
+
+        DB::table('jenjang')->insert(['nama_tipe' => 'SMA']);
+        DB::table('tipemodul')->insert(['nama_tipe' => 'Video']);
+    }
+
+    private function buatUser(int $tipe): User
+    {
+        $this->urut++;
+
+        return User::create([
+            'nama' => "Pengguna {$this->urut}",
+            'email' => "pengguna{$this->urut}@example.com",
+            'password' => bcrypt('password'),
+            'id_tipeuser' => $tipe,
+        ]);
+    }
+
+    private function dataModul(array $ganti = []): array
+    {
+        return array_merge([
+            'judul_modul' => 'Pecahan Dasar',
+            'id_tipemodul' => 1,
+            'id_jenjang' => 1,
+            'file_link' => 'https://www.youtube.com/watch?v=abc123',
+        ], $ganti);
+    }
+
+    private function buatModul(string $judul = 'Modul Awal', string $status = 'Tersedia', ?int $idQuiz = null): Modul
+    {
+        return Modul::create([
+            'judul_modul' => $judul,
+            'file_materi' => 'https://www.youtube.com/watch?v=awal',
+            'tipe_file' => 'link',
+            'id_tipemodul' => 1,
+            'id_jenjang' => 1,
+            'id_quiz' => $idQuiz,
+            'progressModul' => $status,
+        ]);
+    }
+
+    // ---------------------------------------------------------------- ditolak
+
+    public function test_siswa_tidak_boleh_menambah_modul(): void
+    {
+        Sanctum::actingAs($this->buatUser(3));
+
+        $this->postJson('/api/modules', $this->dataModul())
+            ->assertForbidden()
+            ->assertJson(['success' => false]);
+
+        $this->assertDatabaseCount('modul', 0);
+    }
+
+    public function test_orang_tua_tidak_boleh_mengubah_modul(): void
+    {
+        $modul = $this->buatModul();
+        Sanctum::actingAs($this->buatUser(4));
+
+        $this->putJson("/api/modules/{$modul->id_modul}", $this->dataModul(['judul_modul' => 'Diretas']))
+            ->assertForbidden();
+
+        $this->assertDatabaseHas('modul', ['id_modul' => $modul->id_modul, 'judul_modul' => 'Modul Awal']);
+    }
+
+    public function test_siswa_tidak_boleh_menghapus_modul(): void
+    {
+        $modul = $this->buatModul();
+        Sanctum::actingAs($this->buatUser(3));
+
+        $this->deleteJson("/api/modules/{$modul->id_modul}")->assertForbidden();
+
+        $this->assertDatabaseHas('modul', ['id_modul' => $modul->id_modul]);
+    }
+
+    public function test_tanpa_token_dibalas_401_walau_tanpa_header_accept(): void
+    {
+        // Sengaja memakai post() biasa (tanpa Accept: application/json) seperti klien yang lupa header.
+        $this->post('/api/modules', $this->dataModul())->assertUnauthorized();
+    }
+
+    // ---------------------------------------------------------------- membaca
+
+    public function test_siswa_boleh_membaca_modul_terbit_tetapi_tidak_melihat_draf(): void
+    {
+        $this->buatModul('Modul Terbit', 'Tersedia');
+        $draf = $this->buatModul('Modul Rahasia Draf', 'Draft');
+        Sanctum::actingAs($this->buatUser(3));
+
+        $respons = $this->getJson('/api/modules')->assertOk()->assertJson(['success' => true]);
+
+        $this->assertStringContainsString('Modul Terbit', $respons->getContent());
+        $this->assertStringNotContainsString('Modul Rahasia Draf', $respons->getContent());
+
+        $this->getJson("/api/modules/{$draf->id_modul}")->assertNotFound();
+    }
+
+    public function test_guru_boleh_melihat_modul_draf(): void
+    {
+        $draf = $this->buatModul('Modul Draf Guru', 'Draft');
+        Sanctum::actingAs($this->buatUser(2));
+
+        $this->getJson("/api/modules/{$draf->id_modul}")
+            ->assertOk()
+            ->assertJsonPath('data.judul_modul', 'Modul Draf Guru');
+    }
+
+    public function test_token_kuis_tidak_ikut_terkirim_lewat_api_modul(): void
+    {
+        DB::table('quiz')->insert(['id_quiz' => 1, 'judul' => 'Kuis Berpelindung', 'id_jenjang' => 1, 'token' => 'RAHASIA1']);
+        $modul = $this->buatModul('Modul Dengan Kuis', 'Tersedia', 1);
+
+        foreach ([3, 2] as $tipe) {
+            Sanctum::actingAs($this->buatUser($tipe));
+
+            $daftar = $this->getJson('/api/modules')->assertOk();
+            $detail = $this->getJson("/api/modules/{$modul->id_modul}")->assertOk();
+
+            // Kuis tetap ikut, tetapi tanpa token.
+            $this->assertStringContainsString('Kuis Berpelindung', $daftar->getContent());
+            $this->assertStringNotContainsString('RAHASIA1', $daftar->getContent());
+            $this->assertStringNotContainsString('RAHASIA1', $detail->getContent());
+        }
+    }
+
+    public function test_token_kuis_tetap_bisa_dibaca_di_php_tetapi_tidak_di_json(): void
+    {
+        DB::table('quiz')->insert(['id_quiz' => 1, 'judul' => 'Kuis X', 'id_jenjang' => 1, 'token' => 'RAHASIA1']);
+
+        $quiz = Quiz::find(1);
+
+        $this->assertSame('RAHASIA1', $quiz->token);              // dipakai SiswaController & tampilan admin
+        $this->assertArrayNotHasKey('token', $quiz->toArray());   // tidak ikut ke JSON
+    }
+
+    // ---------------------------------------------------------------- diizinkan
+
+    public function test_guru_boleh_menambah_modul(): void
+    {
+        Sanctum::actingAs($this->buatUser(2));
+
+        $this->postJson('/api/modules', $this->dataModul())->assertCreated();
+
+        $this->assertDatabaseHas('modul', ['judul_modul' => 'Pecahan Dasar', 'tipe_file' => 'link']);
+    }
+
+    public function test_admin_boleh_mengubah_modul_dan_judul_sendiri_bukan_duplikat(): void
+    {
+        $modul = $this->buatModul('Modul Awal');
+        Sanctum::actingAs($this->buatUser(1));
+
+        // Judul sama dengan judul modul itu sendiri: harus lolos.
+        $this->putJson("/api/modules/{$modul->id_modul}", $this->dataModul(['judul_modul' => 'Modul Awal']))
+            ->assertOk();
+
+        $this->putJson("/api/modules/{$modul->id_modul}", $this->dataModul(['judul_modul' => 'Modul Baru']))
+            ->assertOk();
+
+        $this->assertDatabaseHas('modul', ['id_modul' => $modul->id_modul, 'judul_modul' => 'Modul Baru']);
+    }
+
+    public function test_admin_boleh_menghapus_modul(): void
+    {
+        $modul = $this->buatModul();
+        Sanctum::actingAs($this->buatUser(1));
+
+        $this->deleteJson("/api/modules/{$modul->id_modul}")->assertOk();
+
+        $this->assertDatabaseMissing('modul', ['id_modul' => $modul->id_modul]);
+    }
+
+    // ---------------------------------------------------------------- validasi API
+
+    public function test_api_menolak_jenjang_dan_jenis_modul_yang_tidak_ada(): void
+    {
+        Sanctum::actingAs($this->buatUser(2));
+
+        // post() biasa: kegagalan validasi tetap JSON 422, bukan redirect.
+        $this->post('/api/modules', $this->dataModul(['id_jenjang' => 999, 'id_tipemodul' => 999]))
+            ->assertStatus(422)
+            ->assertJsonValidationErrors(['id_jenjang', 'id_tipemodul']);
+    }
+
+    public function test_api_menolak_judul_duplikat_saat_menambah(): void
+    {
+        $this->buatModul('Pecahan Dasar');
+        Sanctum::actingAs($this->buatUser(2));
+
+        $this->postJson('/api/modules', $this->dataModul())
+            ->assertStatus(422)
+            ->assertJsonValidationErrors('judul_modul');
+    }
+}
